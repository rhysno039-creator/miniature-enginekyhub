-- Sistem Forced Camera Lock (Shift Lock Murni Berbasis RenderStepped untuk HP)
getgenv().ForcedShiftLock = false
local screenGui = Instance.new("ScreenGui")
screenGui.Name = "KyzenShiftLockGUI"
screenGui.Parent = game:GetService("CoreGui")
screenGui.Enabled = false

local shiftLockBtn = Instance.new("TextButton")
shiftLockBtn.Size = UDim2.new(0, 50, 0, 50)
shiftLockBtn.Position = UDim2.new(0.85, 0, 0.45, 0)
shiftLockBtn.BackgroundColor3 = Color3.fromRGB(0, 0, 0)
shiftLockBtn.BackgroundTransparency = 0.5
shiftLockBtn.Text = "🔒"
shiftLockBtn.TextSize = 22
shiftLockBtn.Parent = screenGui

local isLocked = false
shiftLockBtn.MouseButton1Click:Connect(function()
   isLocked = not isLocked
   if isLocked then
      shiftLockBtn.BackgroundTransparency = 0.1
   else
      shiftLockBtn.BackgroundTransparency = 0.5
   end
end)

RunService.RenderStepped:Connect(function()
   if getgenv().ForcedShiftLock then
      screenGui.Enabled = true
      local char = LocalPlayer.Character
      if char and char:FindFirstChild("HumanoidRootPart") and char:FindFirstChild("Humanoid") then
         local hrp = char.HumanoidRootPart
         local humanoid = char.Humanoid
         
         if isLocked then
            -- Memaksa badan karakter selalu menghadap ke arah kamera secara mutlak
            local camCF = Camera.CFrame
            hrp.CFrame = CFrame.new(hrp.Position, Vector3.new(camCF.LookVector.X * 9999, hrp.Position.Y, camCF.LookVector.Z * 9999))
            humanoid.AutoRotate = false
         else
            humanoid.AutoRotate = true
         end
      end
   else
      screenGui.Enabled = false
      isLocked = false
      local char = LocalPlayer.Character
      if char and char:FindFirstChild("Humanoid") then
         char.Humanoid.AutoRotate = true
      end
   end
end)

