MoveTab:CreateSection("Flight & Speed Control")

getgenv().AeroFlyActive = false
getgenv().AeroFlySpeed = 50
local flyConnection

MoveTab:CreateToggle({
   Name = "Aero Flight",
   CurrentValue = false,
   Flag = "AeroFlyToggle",
   Callback = function(Value)
      getgenv().AeroFlyActive = Value
      local char = LocalPlayer.Character
      if not char then return end
      local hrp = char:FindFirstChild("HumanoidRootPart")
      local humanoid = char:FindFirstChild("Humanoid")
      
      if Value then
         if humanoid then humanoid.PlatformStand = true end
         if hrp then
            local bv = Instance.new("BodyVelocity")
            bv.Name = "KyzenFlyVelocity"
            bv.Parent = hrp
            bv.MaxForce = Vector3.new(math.huge, math.huge, math.huge)
            bv.Velocity = Vector3.new(0, 0, 0)
            
            local bg = Instance.new("BodyGyro")
            bg.Name = "KyzenFlyGyro"
            bg.Parent = hrp
            bg.MaxTorque = Vector3.new(math.huge, math.huge, math.huge)
            bg.CFrame = hrp.CFrame
            
            flyConnection = RunService.RenderStepped:Connect(function()
               if not getgenv().AeroFlyActive then
                  if bv then bv:Destroy() end
                  if bg then bg:Destroy() end
                  if humanoid then humanoid.PlatformStand = false end
                  if flyConnection then flyConnection:Disconnect() end
                  return
               end
               
               if hrp and Camera then
                  bg.CFrame = Camera.CFrame
                  local moveDir = Vector3.new(0, 0, 0)
                  
                  -- Mengembalikan arah analog maju ke posisi semula (Z < 0 untuk maju)
                  if UserInputService:IsKeyDown(Enum.KeyCode.W) or humanoid.MoveDirection.Z < 0 then
                     moveDir = moveDir + (Camera.CFrame.LookVector)
                  end
                  if UserInputService:IsKeyDown(Enum.KeyCode.S) or humanoid.MoveDirection.Z > 0 then
                     moveDir = moveDir - (Camera.CFrame.LookVector)
                  end
                  if UserInputService:IsKeyDown(Enum.KeyCode.D) or humanoid.MoveDirection.X > 0 then
                     moveDir = moveDir + (Camera.CFrame.RightVector)
                  end
                  if UserInputService:IsKeyDown(Enum.KeyCode.A) or humanoid.MoveDirection.X < 0 then
                     moveDir = moveDir - (Camera.CFrame.RightVector)
                  end
                  
                  bv.Velocity = moveDir * getgenv().AeroFlySpeed
               end
            end)
         end
      else
         if humanoid then humanoid.PlatformStand = false end
         if hrp then
            if hrp:FindFirstChild("KyzenFlyVelocity") then hrp.KyzenFlyVelocity:Destroy() end
            if hrp:FindFirstChild("KyzenFlyGyro") then hrp.KyzenFlyGyro:Destroy() end
         end
         if flyConnection then flyConnection:Disconnect() end
      end
   end,
})

