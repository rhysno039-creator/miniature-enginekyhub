-- ==================== NOTIFIKASI & PEREKAMAN POSISI AWAL ====================
Window:Notify({
   Title = "⚠️ PERINGATAN",
   Content = "Jangan bergerak! Sedang merekam posisi awal Anda...",
   Duration = 5,
   Image = 4483362458,
})

local Players = game:GetService("Players")
local Workspace = game:GetService("Workspace")
local RunService = game:GetService("RunService")
local LocalPlayer = Players.LocalPlayer

local autoTreadmillEnabled = false
local auto2xTrainEnabled = false
local instantInteractEnabled = false

-- Variabel untuk menyimpan posisi persis saat script di-execute
local initialExecutionCFrame = CFrame.new(0, 10, 0)

-- Task untuk merekam posisi awal setelah karakter siap
task.spawn(function()
   local char = LocalPlayer.Character or LocalPlayer.CharacterAdded:Wait()
   local hrp = char:WaitForChild("HumanoidRootPart", 5)
   if hrp then
      initialExecutionCFrame = hrp.CFrame
      Window:Notify({
         Title = "KyZen HUB",
         Content = "✅ Berhasil! Posisi awal & treadmill Anda telah dikunci.",
         Duration = 4,
         Image = 4483362458,
      })
   else
      Window:Notify({
         Title = "KyZen HUB",
         Content = "❌ Gagal mendeteksi posisi, menggunakan default.",
         Duration = 4,
         Image = 4483362458,
      })
   end
end)

local function getBaseCFrame()
   return initialExecutionCFrame
end

local function getTreadmillCFrame()
   return initialExecutionCFrame
end

-- Fungsi Deteksi Biome/Area
local function getBiomePart(biomeName)
   local searchFolders = {Workspace, Workspace:FindFirstChild("Map"), Workspace:FindFirstChild("World"), Workspace:FindFirstChild("Biomes"), Workspace:FindFirstChild("Zones")}
   for _, folder in ipairs(searchFolders) do
      if folder then
         for _, v in ipairs(folder:GetDescendants()) do
            if v.Name:lower() == biomeName:lower() or v.Name:lower():find(biomeName:lower()) then
               if v:IsA("Model") and v.PrimaryPart then
                  return v.PrimaryPart.CFrame + Vector3.new(0, 5, 0)
               elseif v:IsA("BasePart") then
                  return v.CFrame + Vector3.new(0, 5, 0)
               end
            end
         end
      end
   end
   return nil
end

-- Auto Treadmill Loop (Mencari Remote terdekat dari posisi eksekusi)
task.spawn(function()
   while true do
      if autoTreadmillEnabled then
         pcall(function()
            local remote = Workspace:FindFirstChild("TreadmillRemote", true) or Workspace:FindFirstChild("TrainRemote", true)
            if remote and remote:IsA("RemoteEvent") then
               remote:FireServer()
            else
               -- Cari di sekitar posisi awal player
               for _, v in ipairs(Workspace:GetDescendants()) do
                  if v:IsA("RemoteEvent") and (v.Name:lower():find("treadmill") or v.Name:lower():find("train")) then
                     v:FireServer()
                     break
                  end
               end
            end
         end)
      end
      task.wait(0.5)
   end
end)

-- Auto 2X Train / Boost Loop
task.spawn(function()
   while true do
      if auto2xTrainEnabled then
         pcall(function()
            local remote2x = Workspace:FindFirstChild("2XTrainRemote", true) or Workspace:FindFirstChild("BoostRemote", true)
            if remote2x and remote2x:IsA("RemoteEvent") then
               remote2x:FireServer()
            end
         end)
      end
      task.wait(1)
   end
end)

-- Instant Interact Loop (ProximityPrompt)
task.spawn(function()
   while true do
      if instantInteractEnabled then
         pcall(function()
            for _, v in ipairs(Workspace:GetDescendants()) do
               if v:IsA("ProximityPrompt") then
                  v.HoldDuration = 0
               end
            end
         end)
      end
      task.wait(1)
   end
end)


