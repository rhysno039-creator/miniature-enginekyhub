-- Tombol Teleport Biome / Area
local biomes = {"Meadow", "Wetlands", "Safari", "Crystalline", "Arctic", "Jungle", "Prehistoric", "Abyss", "Mythical"}

for _, biomeName in ipairs(biomes) do
   TeleportTab:CreateButton({
      Name = "Teleport ke Biome: " .. biomeName,
      Callback = function()
         pcall(function()
            local char = LocalPlayer.Character
            if char and char:FindFirstChild("HumanoidRootPart") then
               local targetCF = getBiomePart(biomeName)
               if targetCF then
                  char.HumanoidRootPart.CFrame = targetCF
               end
            end
         end)
      end,
   })
end


-- ==================== TAB 3: PLAYER & SECURITY ====================
local PlayerTab = Window:CreateTab("Player & Security", 4483362458)

local wsEnabled = false
local wsValue = 16

PlayerTab:CreateToggle({
   Name = "Enable WalkSpeed",
   CurrentValue = false,
   Flag = "WSToggle",
   Callback = function(Value)
      wsEnabled = Value
      if not wsEnabled and LocalPlayer.Character and LocalPlayer.Character:FindFirstChildOfClass("Humanoid") then
         LocalPlayer.Character:FindFirstChildOfClass("Humanoid").WalkSpeed = 16
      end
   end,
})

PlayerTab:CreateInput({
   Name = "Set WalkSpeed (Limit: 200)",
   CurrentValue = "16",
   PlaceholderText = "Masukkan angka (1 - 200)...",
   RemoveTextAfterFocusLost = false,
   Flag = "WSInput",
   Callback = function(Text)
      local num = tonumber(Text)
      if num then
         if num > 200 then
            LocalPlayer:Kick("KyZen HUB Security: WalkSpeed melebihi batas maksimal 200! Anda telah di-kick.")
         else
            wsValue = num
         end
      end
   end,
})

-- Loop Proteksi WalkSpeed & Anti-Bypass (>200 Kick)
RunService.RenderStepped:Connect(function()
   if wsEnabled then
      if LocalPlayer.Character and LocalPlayer.Character:FindFirstChildOfClass("Humanoid") then
         local hum = LocalPlayer.Character:FindFirstChildOfClass("Humanoid")
         if hum.WalkSpeed > 200 then
            LocalPlayer:Kick("KyZen HUB Security: WalkSpeed melebihi batas maksimal 200! Anda telah di-kick.")
         else
            hum.WalkSpeed = wsValue
         end
      end
   end
end)
