local Rayfield = loadstring(game:HttpGet('https://sirius.menu/rayfield'))()
local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local UserInputService = game:GetService("UserInputService")
local Workspace = game:GetService("Workspace")
local LocalPlayer = Players.LocalPlayer
local Camera = Workspace.CurrentCamera

local Window = Rayfield:CreateWindow({
   Name = "KYZEN HUB v2 | Advanced Movement",
   LoadingTitle = "KYZEN HUB",
   LoadingSubtitle = "Elite Movement Module",
   ConfigurationSaving = { Enabled = false }
})

local MoveTab = Window:CreateTab("Movement", 4483345998)
MoveTab:CreateSection("Ultimate Movement Control Suite")

-- 1. Aero Flight (Fixed directions & Camera relative)
getgenv().AeroFlyActive = false
getgenv().AeroFlySpeed = 50
local aeroFlyConn

MoveTab:CreateToggle({
   Name = "🚀 Aero Flight",
   CurrentValue = false,
   Flag = "AeroFlyToggle",
   Callback = function(Value)
      getgenv().AeroFlyActive = Value
      local char = LocalPlayer.Character
      if char and char:FindFirstChild("HumanoidRootPart") and char:FindFirstChild("Humanoid") then
         char.Humanoid.PlatformStand = Value
      end
      
      if Value then
         local bodyGyro = Instance.new("BodyGyro")
         local bodyVelocity = Instance.new("BodyVelocity")
         bodyGyro.P = 9e4
         bodyGyro.maxTorque = Vector3.new(9e9, 9e9, 9e9)
         bodyVelocity.maxForce = Vector3.new(9e9, 9e9, 9e9)
         
         local hrp = char:FindFirstChild("HumanoidRootPart")
         if hrp then
            bodyGyro.Parent = hrp
            bodyVelocity.Parent = hrp
         end
         
         aeroFlyConn = RunService.RenderStepped:Connect(function()
            if not getgenv().AeroFlyActive then 
               bodyGyro:Destroy()
               bodyVelocity:Destroy()
               if char and char:FindFirstChild("Humanoid") then
                  char.Humanoid.PlatformStand = false
               end
               if aeroFlyConn then aeroFlyConn:Disconnect() end
               return 
            end
            
            if char and char:FindFirstChild("HumanoidRootPart") then
               bodyGyro.CFrame = Camera.CFrame
               local moveDir = Vector3.new()
               
               if UserInputService:IsKeyDown(Enum.KeyCode.W) then
                  moveDir = moveDir + Camera.CFrame.LookVector
               end
               if UserInputService:IsKeyDown(Enum.KeyCode.S) then
                  moveDir = moveDir - Camera.CFrame.LookVector
               end
               if UserInputService:IsKeyDown(Enum.KeyCode.D) then
                  moveDir = moveDir + Camera.CFrame.RightVector
               end
               if UserInputService:IsKeyDown(Enum.KeyCode.A) then
                  moveDir = moveDir - Camera.CFrame.RightVector
               end
               if UserInputService:IsKeyDown(Enum.KeyCode.Space) then
                  moveDir = moveDir + Vector3.new(0, 1, 0)
               end
               if UserInputService:IsKeyDown(Enum.KeyCode.LeftControl) then
                  moveDir = moveDir - Vector3.new(0, 1, 0)
               end
               
               bodyVelocity.velocity = moveDir * getgenv().AeroFlySpeed
            end
         end)
      end
   end,
})

MoveTab:CreateInput({
   Name = "⚡ Flight Velocity (No Limit)",
   PlaceholderText = "Masukkan kecepatan...",
   RemoveTextAfterFocusLost = false,
   Callback = function(Text)
      local num = tonumber(Text)
      if num then getgenv().AeroFlySpeed = num end
   end,
})

