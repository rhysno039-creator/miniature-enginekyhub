                            hl.OutlineColor = Color3.fromRGB(255, 255, 255)
                            hl.FillTransparency = 0.5
                            hl.Parent = player.Character
                        end
                    else
                        if player.Character:FindFirstChild("KyZenHighlight") then
                            player.Character.KyZenHighlight:Destroy()
                        end
                    end
                end
