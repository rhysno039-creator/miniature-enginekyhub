-- // FLY V5 CAMERA - FIX ANALOG LICIN (PERSIS SESUAI PERMINTAAN)
local plr = game.Players.LocalPlayer
local rs = game:GetService("RunService")
local bv,bg,conn
local flySpeed = 35

local function StartFly(speed)
    if speed > 500 then plr:Kick("Limit 500!") return end
    local char = plr.Character
    local hrp = char:WaitForChild("HumanoidRootPart")
    local hum = char:WaitForChild("Humanoid")
    local cam = workspace.CurrentCamera
    hum.PlatformStand = true

    bv = Instance.new("BodyVelocity")
    bv.MaxForce = Vector3.new(9e9,9e9,9e9)
    bv.Velocity = Vector3.new(0,0,0)
    bv.Parent = hrp

    bg = Instance.new("BodyGyro")
    bg.MaxTorque = Vector3.new(9e9,9e9,9e9)
    bg.D = 15
    bg.P = 5000
    bg.Parent = hrp

    conn = rs.Heartbeat:Connect(function()
        if hrp.Anchored then hrp.Anchored = false end
        
        local move = hum.MoveDirection -- ini dari analog HP
        local camCF = cam.CFrame

        if move.Magnitude > 0.01 then -- sensitif banget buat analog
            -- FIX ANALOG: jangan pake -move.Z, pake move langsung + boost
            local vel = (camCF.LookVector * move.Z + camCF.RightVector * move.X) * speed
            
            -- Kalo analog HP kadang kebalik, ini versi anti kebalik:
            -- W maju = LookVector, jadi harusnya -Z di PC tapi di HP Z nya udah bener
            -- Gw bikin auto detect
            if move.Z < 0 then
                vel = (camCF.LookVector * -move.Z + camCF.RightVector * move.X) * speed
            else
                vel = (camCF.LookVector * -move.Z + camCF.RightVector * move.X) * speed * 0.7
            end

            -- INI KUNCI BIAR GAK KAKU: langsung set, jangan di Lerp lama
            bv.Velocity = bv.Velocity:Lerp(vel, 0.35) -- 0.35 = responsif buat analog, tadi 0.12 kelamaan
        else
            -- Kalo lepas analog, ngerem halus
            bv.Velocity = bv.Velocity:Lerp(Vector3.new(0,0,0), 0.25)
        end

        bg.CFrame = bg.CFrame:Lerp(camCF, 0.35) -- kamera juga responsif
    end)
end

local function StopFly()
    local char = plr.Character
    if char then
        local hum = char:FindFirstChildOfClass("Humanoid")
        if hum then hum.PlatformStand = false end
        for _,v in pairs(char.HumanoidRootPart:GetChildren()) do
            if v:IsA("BodyVelocity") or v:IsA("BodyGyro") then v:Destroy() end
        end
    end
    if conn then conn:Disconnect() end
end

