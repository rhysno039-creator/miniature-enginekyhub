-- Cari Remote secara aman (Tidak bikin script macet jika jalur berbeda)
local treadmillRemote = nil
task.spawn(function()
    pcall(function()
        local packages = ReplicatedStorage:WaitForChild("Packages", 3)
        if packages then
            local networker = packages:WaitForChild("Networker", 3)
            if networker then
                local remotes = networker:WaitForChild("_remotes", 3)
                if remotes then
                    local treadmill = remotes:WaitForChild("Treadmill", 3)
                    if treadmill then
                        treadmillRemote = treadmill:WaitForChild("RemoteEvent", 3)
                    end
                end
            end
        end
    end)
end)

