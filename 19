-- Fungsi Deteksi Plot & Base Dinamis
local function getMyPlot()
    local plotsFolder = workspace:FindFirstChild("Plots") or workspace:FindFirstChild("Tycoons") or workspace:FindFirstChild("PlayerPlots")
    if plotsFolder then
        for _, plot in ipairs(plotsFolder:GetChildren()) do
            local owner = plot:FindFirstChild("Owner")
            if owner and (owner.Value == LocalPlayer or owner.Value == LocalPlayer.Name) then
                return plot
            end
        end
    end
    return nil
end

local function getBaseCFrame()
    local plot = getMyPlot()
    if plot then
        local spawnPart = plot:FindFirstChild("SpawnLocation") or plot:FindFirstChild("Base") or plot.PrimaryPart
        if spawnPart then
            return spawnPart.CFrame + Vector3.new(0, 3, 0)
        end
    end
    return CFrame.new(116.13, 5.70, 12.37)
end

local function getTreadmillCFrame()
    local plot = getMyPlot()
    if plot then
        for _, obj in ipairs(plot:GetDescendants()) do
            if obj.Name:lower():find("treadmill") and (obj:IsA("BasePart") or obj:IsA("Model")) then
                if obj:IsA("Model") and obj.PrimaryPart then
                    return obj.PrimaryPart.CFrame + Vector3.new(0, 3, 0)
                elseif obj:IsA("BasePart") then
                    return obj.CFrame + Vector3.new(0, 3, 0)
                end
            end
        end
    end
    local baseCF = getBaseCFrame()
    if baseCF then
        return baseCF + Vector3.new(27.96, 0, 19.50)
    end
    return CFrame.new(144.09, 5.70, 31.87)
end

