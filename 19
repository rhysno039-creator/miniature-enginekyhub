-- Background Loops (Menggunakan pcall agar aman jika remote belum siap)
task.spawn(function()
    while true do
        if _G.AutoTreadmill and treadmillRemote then
            pcall(function()
                local char = LocalPlayer.Character
                if char and char:FindFirstChild("HumanoidRootPart") then
                    char.HumanoidRootPart.CFrame = getTreadmillCFrame()
                end
                treadmillRemote:FireServer("enterTreadmill")
            end)
        end
        task.wait(1)
    end
end)

task.spawn(function()
    while true do
        if _G.AutoBoost and treadmillRemote then
            pcall(function()
                treadmillRemote:FireServer("claimBoost")
            end)
        end
        task.wait(1)
    end
end)
