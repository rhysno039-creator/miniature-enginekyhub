-- Auto Hit Enemy (Mencari objek/pintu/target secara dinamis di workspace)
task.spawn(function()
    while true do
        if autoHit then
            pcall(function()
                local targetInstance = nil
                local wallFolder = workspace:FindFirstChild("WallFolder")
                if wallFolder then
                    for _, zone in ipairs(wallFolder:GetChildren()) do
                        local doors = zone:FindFirstChild("Doors")
                        if doors and doors:FindFirstChild("Door") then
                            targetInstance = doors.Door
                            break
                        end
                    end
                end
                
                if not targetInstance then
                    targetInstance = workspace:FindFirstChildWhichIsA("BasePart", true)
                end

                if targetInstance then
                    local args = {
                        {
                            Normal = Vector3.new(-1, 0, 0),
                            BulletCFrame = CFrame.new(646.7847, 16.9865, -155.8615),
                            BulletColor = Color3.new(1, 1, 0),
                            Owner = LocalPlayer,
                            Position = Vector3.new(599, 19.1177, -134.0299),
                            InitialCFrame = CFrame.new(542.2810, 21.6474, -108.1163),
                            Material = Enum.Material.Plastic,
                            Instance = targetInstance,
                            Distance = 69.9095
                        }
                    }
                    HittedRF:InvokeServer(unpack(args))
                end
            end)
        end
        task.wait(0.5)
    end
end)

