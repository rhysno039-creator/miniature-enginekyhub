-- 8. Forced Camera Lock (Shift Lock Fix via PlayerModule Hook)
getgenv().ForcedShiftLock = false
RunService.RenderStepped:Connect(function()
   if getgenv().ForcedShiftLock then
      LocalPlayer.DevEnableMouseLock = true
      pcall(function()
         LocalPlayer.PlayerScripts.PlayerModule.CameraModule.MouseLockController:IsMouseLocked()
         -- Memaksa status shift lock menyala menggunakan event game
         local camModule = require(LocalPlayer.PlayerScripts:WaitForChild("PlayerModule"):WaitForChild("CameraModule"))
         camModule.MouseLockController:SetMouseLocked(true)
      end)
   end
end)

MoveTab:CreateToggle({
   Name = "🔒 Forced Camera Lock",
   CurrentValue = false,
   Flag = "ShiftLockToggle",
   Callback = function(Value)
      getgenv().ForcedShiftLock = Value
      if not Value then
         pcall(function()
            local camModule = require(LocalPlayer.PlayerScripts.PlayerModule.CameraModule)
            camModule.MouseLockController:SetMouseLocked(false)
         end)
      end
   end,
})

