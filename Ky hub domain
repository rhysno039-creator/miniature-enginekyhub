local CloneCount = 0

UtilityTab:CreateButton({
    Name = "Clone My Avatar (Spawn Copy)",
    Callback = function()
        local char = getCharacter()
        local root = getRoot()
        
        if char and root then
            char.Archivable = true
            local clonedChar = char:Clone()
            char.Archivable = false
            
            CloneCount = CloneCount + 1
            clonedChar.Name = LocalPlayer.Name .. "_Clone_" .. CloneCount
            
            local spawnOffset = Vector3.new((CloneCount * 3), 0, 0)
            clonedChar:MoveTo(root.Position + spawnOffset)
            clonedChar.Parent = Workspace
            
            for _, script in pairs(clonedChar:GetDescendants()) do
                if script:IsA("LocalScript") or script:IsA("Script") then
                    script:Destroy()
                end
            end
            
            Rayfield:Notify({Title = "Clone Avatar", Content = "Spawned Clone Avatar #" .. CloneCount, Duration = 3})
        end
    end
})

UtilityTab:CreateButton({
    Name = "Clear All Clones",
