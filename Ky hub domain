        Lighting.GlobalShadows = false
        Lighting.ClockTime = 12
        Lighting.Ambient = Color3.fromRGB(255, 255, 255)
    end

    local char = getCharacter()
    if char then
        if Flags.Invisible then
            for _, v in pairs(char:GetDescendants()) do
                if v:IsA("BasePart") or v:IsA("Decal") then
                    v.Transparency = 1
                end
            end
        else
            local root = getRoot()
            if root then root.Transparency = 1 end
        end
    end

    if Flags.PlayerESP then
        for _, p in pairs(Players:GetPlayers()) do
            if p ~= LocalPlayer and p.Character then
                local playerChar = p.Character
                local head = playerChar:FindFirstChild("Head")
                
                local highlight = playerChar:FindFirstChild("KyESP_Highlight")
                if not highlight then
                    highlight = Instance.new("Highlight", playerChar)
                    highlight.Name = "KyESP_Highlight"
                    highlight.FillColor = Color3.fromRGB(255, 0, 0)
                    highlight.OutlineColor = Color3.fromRGB(255, 255, 255)
                    highlight.FillTransparency = 0.5
                    highlight.OutlineTransparency = 0
                end

                if head then
                    local tag = head:FindFirstChild("KyESP_Tag")
                    if not tag then
                        tag = Instance.new("BillboardGui", head)
                        tag.Name = "KyESP_Tag"
                        tag.Size = UDim2.new(0, 120, 0, 40)
                        tag.StudsOffset = Vector3.new(0, 2, 0)
                        tag.AlwaysOnTop = true
                        
                        local txt = Instance.new("TextLabel", tag)
                        txt.Name = "Label"
                        txt.Size = UDim2.new(1, 0, 1, 0)
                        txt.BackgroundTransparency = 1
                        txt.TextColor3 = Color3.fromRGB(255, 50, 50)
                        txt.TextStrokeTransparency = 0
                        txt.Font = Enum.Font.SourceSansBold
                        txt.TextSize = 13
                    end
                    
                    local myRoot = getRoot()
                    local dist = myRoot and math.floor((head.Position - myRoot.Position).Magnitude) or 0
                    tag.Label.Text = p.Name .. "\n[" .. dist .. " Studs]"
                end
            end
        end
    end

    if Flags.NPCESP then
        for _, model in pairs(Workspace:GetDescendants()) do
            if model:IsA("Model") and model ~= LocalPlayer.Character and model:FindFirstChildOfClass("Humanoid") then
                if not Players:GetPlayerFromCharacter(model) then
                    local head = model:FindFirstChild("Head")
                    
                    local highlight = model:FindFirstChild("KyNPC_Highlight")
                    if not highlight then
                        highlight = Instance.new("Highlight", model)
                        highlight.Name = "KyNPC_Highlight"
                        highlight.FillColor = Color3.fromRGB(0, 150, 255)
                        highlight.OutlineColor = Color3.fromRGB(255, 255, 255)
                        highlight.FillTransparency = 0.5
                        highlight.OutlineTransparency = 0
                    end
                    
                    if head then
                        local tag = head:FindFirstChild("KyNPC_ESP_Tag")
                        if not tag then
                            tag = Instance.new("BillboardGui", head)
                            tag.Name = "KyNPC_ESP_Tag"
                            tag.Size = UDim2.new(0, 120, 0, 40)
                            tag.StudsOffset = Vector3.new(0, 2, 0)
                            tag.AlwaysOnTop = true
                            
                            local txt = Instance.new("TextLabel", tag)
                            txt.Name = "Label"
                            txt.Size = UDim2.new(1, 0, 1, 0)
                            txt.BackgroundTransparency = 1
                            txt.TextColor3 = Color3.fromRGB(80, 200, 255)
                            txt.TextStrokeTransparency = 0
                            txt.Font = Enum.Font.SourceSansBold
                            txt.TextSize = 13
                        end
                        
                        local myRoot = getRoot()
                        local dist = myRoot and math.floor((head.Position - myRoot.Position).Magnitude) or 0
                        tag.Label.Text = "[NPC] " .. model.Name .. "\n[" .. dist .. " Studs]"
                    end
                end
            end
        end
    end

    for _, p in pairs(Players:GetPlayers()) do
        if p ~= LocalPlayer and p.Character then
            for _, v in pairs(p.Character:GetDescendants()) do
                if v:IsA("BasePart") then v.LocalTransparencyModifier = Flags.GhostOther and 1 or 0 end
            end
        end
    end

    if Flags.HitboxExtender then
        for _, p in pairs(Players:GetPlayers()) do
            if p ~= LocalPlayer and p.Character and p.Character:FindFirstChild("HumanoidRootPart") then
                local hrp = p.Character.HumanoidRootPart
                hrp.Size = Vector3.new(Flags.HitboxSize, Flags.HitboxSize, Flags.HitboxSize)
                hrp.Transparency = 0.5
                hrp.Color = Color3.fromRGB(255, 0, 0)
                hrp.Material = Enum.Material.Neon
                hrp.CanCollide = false
            end
        end
    end

    pcall(function()
        if typeof(Drawing) ~= "table" and typeof(Drawing) ~= "userdata" then return end
        local cam = Workspace.CurrentCamera
        local viewportSize = cam.ViewportSize
        local bottomCenter = Vector2.new(viewportSize.X / 2, viewportSize.Y)

        if not Flags.PlayerTracers then
            for _, line in pairs(PlayerTracersLines) do pcall(function() line:Remove() end) end
            table.clear(PlayerTracersLines)
        else
            for _, p in pairs(Players:GetPlayers()) do
                if p ~= LocalPlayer and p.Character and p.Character:FindFirstChild("HumanoidRootPart") then
                    local hrp = p.Character.HumanoidRootPart
                    local vector, onScreen = cam:WorldToViewportPoint(hrp.Position)
                    local line = PlayerTracersLines[p.Name] or Drawing.new("Line")
                    PlayerTracersLines[p.Name] = line
                    
                    if onScreen then
                        line.From = bottomCenter
                        line.To = Vector2.new(vector.X, vector.Y)
                        line.Color = Color3.fromRGB(255, 0, 0)
                        line.Thickness = 1.5
                        line.Transparency = 1
                        line.Visible = true
                    else
                        line.Visible = false
                    end
                elseif PlayerTracersLines[p.Name] then
                    PlayerTracersLines[p.Name].Visible = false
                end
            end
        end

        if not Flags.NPCTracers then
            for _, line in pairs(NPCTracersLines) do pcall(function() line:Remove() end) end
            table.clear(NPCTracersLines)
        else
            for _, model in pairs(Workspace:GetDescendants()) do
                if model:IsA("Model") and model ~= LocalPlayer.Character and model:FindFirstChildOfClass("Humanoid") then
                    if not Players:GetPlayerFromCharacter(model) then
                        local rootPart = model:FindFirstChild("HumanoidRootPart") or model:FindFirstChild("Head")
                        if rootPart then
                            local vector, onScreen = cam:WorldToViewportPoint(rootPart.Position)
                            local lineKey = tostring(model:GetDebugId())
                            local line = NPCTracersLines[lineKey] or Drawing.new("Line")
                            NPCTracersLines[lineKey] = line
                            
                            if onScreen then
                                line.From = bottomCenter
                                line.To = Vector2.new(vector.X, vector.Y)
                                line.Color = Color3.fromRGB(0, 150, 255)
                                line.Thickness = 1.5
                                line.Transparency = 1
                                line.Visible = true
                            else
                                line.Visible = false
                            end
                        end
                    end
                end
            end
        end
    end)
end)

