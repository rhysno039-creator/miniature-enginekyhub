RunService.Stepped:Connect(function(_, delta)
    local hum, root = getHumanoid(), getRoot()
    local cam = Workspace.CurrentCamera
    
    if Flags.Fly and root and hum then
        Workspace.Gravity = 0
        root.AssemblyLinearVelocity = Vector3.zero
        root.AssemblyAngularVelocity = Vector3.zero
        
        local targetCFrame = CFrame.new(root.Position, root.Position + cam.CFrame.LookVector)
        root.CFrame = root.CFrame:Lerp(targetCFrame, 0.25)
        
        local moveDir = hum.MoveDirection
        if moveDir.Magnitude > 0 then
            local flatForward = Vector3.new(cam.CFrame.LookVector.X, 0, cam.CFrame.LookVector.Z).Unit
            local flatRight = Vector3.new(cam.CFrame.RightVector.X, 0, cam.CFrame.RightVector.Z).Unit
            local forwardInput = moveDir:Dot(flatForward)
            local rightInput = moveDir:Dot(flatRight)
            
            local flyVector = (cam.CFrame.LookVector * forwardInput) + (cam.CFrame.RightVector * rightInput)
            if flyVector.Magnitude > 0 then
                root.CFrame = root.CFrame + (flyVector.Unit * (Flags.FlySpeed * delta))
            end
        end
    end
    
    if Flags.Noclip and LocalPlayer.Character then
        for _, v in pairs(LocalPlayer.Character:GetDescendants()) do
            if v:IsA("BasePart") then v.CanCollide = false end
        end
    end
end)

RunService.RenderStepped:Connect(function()
    local hum, root = getHumanoid(), getRoot()
    local cam = Workspace.CurrentCamera
    
    if hum then
        if Flags.WalkSpeed then hum.WalkSpeed = Flags.WalkSpeedVal end
        if Flags.JumpPower then 
            hum.UseJumpPower = true 
            hum.JumpPower = Flags.JumpPowerVal 
        end
    end
    
    if Flags.MoonWalk and hum and root and hum.MoveDirection.Magnitude > 0 then
        root.CFrame = root.CFrame * CFrame.Angles(0, math.rad(180), 0)
    end
    
    if Flags.TPWalk and hum and root and hum.MoveDirection.Magnitude > 0 then
        root.CFrame = root.CFrame + (hum.MoveDirection * Flags.TPWalkSpeed)
    end

    if Flags.ShiftLock and not Flags.Fly and root then
        local lookVector = cam.CFrame.LookVector
        root.CFrame = CFrame.new(root.Position, root.Position + Vector3.new(lookVector.X, 0, lookVector.Z))
    end
end)

