SettingTab:Section({ Title = "Config / Custom Name Tag" })

local nameTagEnabled = false
local customNameString = LocalPlayer.Name
local verifiedEnabled = true

local function refreshNameTag()
    pcall(function()
        if not Character then return end
        local head = Character:FindFirstChild("Head")
        if not head then return end
        
        local existingGui = head:FindFirstChild("KyZenCustomTag")
        if nameTagEnabled then
            if not existingGui then
                existingGui = Instance.new("BillboardGui")
                existingGui.Name = "KyZenCustomTag"
                existingGui.Size = UDim2.new(0, 200, 0, 50)
                existingGui.StudsOffset = Vector3.new(0, 2.5, 0)
                existingGui.AlwaysOnTop = true
                existingGui.Parent = head
                
                local tLabel = Instance.new("TextLabel")
                tLabel.Name = "TagText"
                tLabel.Size = UDim2.new(1, 0, 1, 0)
                tLabel.BackgroundTransparency = 1
                tLabel.TextColor3 = Color3.fromRGB(255, 255, 255)
                tLabel.TextStrokeTransparency = 0
                tLabel.TextSize = 18
                tLabel.Font = Enum.Font.GothamBold
                tLabel.Parent = existingGui
            end
            
            local tLabel = existingGui:FindFirstChild("TagText")
            if tLabel then
                tLabel.RichText = true
                local badge = verifiedEnabled and " <font color='#3897f0'>✔</font>" or ""
                tLabel.Text = customNameString .. badge
            end
        else
            if existingGui then
                existingGui:Destroy()
            end
        end
    end)
end

-- Refresh name tag saat karakter respawn baru
LocalPlayer.CharacterAdded:Connect(function(newChar)
    Character = newChar
    Humanoid = newChar:WaitForChild("Humanoid")
    HumanoidRootPart = newChar:WaitForChild("HumanoidRootPart")
    task.wait(0.5)
    refreshNameTag()
end)

SettingTab:Toggle({
    Title = "Enable Custom Name Tag",
    Default = false,
    Callback = function(v)
        nameTagEnabled = v
        refreshNameTag()
    end
})

SettingTab:Input({
