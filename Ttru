                antiRagdollConnection:Disconnect()
                antiRagdollConnection = nil
            end
        end
    end
})

-- Anti Fall Damage
local antiFallEnabled = false
local antiFallConnection = nil

PlayerTab:Toggle({
    Title = "Anti Fall Damage",
    Default = false,
    Callback = function(v)
        antiFallEnabled = v
        if antiFallEnabled then
            pcall(function()
                if Humanoid then
                    local lastHealth = Humanoid.Health
                    antiFallConnection = Humanoid.HealthChanged:Connect(function(newHealth)
                        if antiFallEnabled and newHealth < lastHealth then
                            local state = Humanoid:GetState()
                            if state == Enum.HumanoidStateType.Freefall or state == Enum.HumanoidStateType.FallingDown or state == Enum.HumanoidStateType.Land then
                                Humanoid.Health = lastHealth
                            else
                                lastHealth = newHealth
                            end
                        else
                            lastHealth = newHealth
                        end
                    end)
                end
            end)
        else
            if antiFallConnection then
                antiFallConnection:Disconnect()
                antiFallConnection = nil
            end
        end
    end
})

