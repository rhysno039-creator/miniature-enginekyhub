local Camera = Workspace.CurrentCamera

local Window = Rayfield:CreateWindow({
   Name = "KYZEN HUB v2 | Advanced Movement",
   LoadingTitle = "KYZEN HUB",
   LoadingSubtitle = "Elite Movement Module",
   ConfigurationSaving = { Enabled = false }
})

local MoveTab = Window:CreateTab("Movement", 4483345998)
MoveTab:CreateSection("Ultimate Movement Control Suite")

-- 1. CFrame Fly (Camera-relative Up/Down movement)
getgenv().AeroFlyActive = false
getgenv().AeroFlySpeed = 50
local aeroFlyConn

MoveTab:CreateToggle({
   Name = "🚀 Aero Flight [ON/OFF]",
   CurrentValue = false,
   Flag = "AeroFlyToggle",
   Callback = function(Value)
      getgenv().AeroFlyActive = Value
      if Value then
         local bodyGyro = Instance.new("BodyGyro")
         local bodyVelocity = Instance.new("BodyVelocity")
         bodyGyro.P = 9e4
         bodyGyro.maxTorque = Vector3.new(9e9, 9e9, 9e9)
         
         aeroFlyConn = RunService.RenderStepped:Connect(function()
            if not getgenv().AeroFlyActive then 
               bodyGyro:Destroy()
               bodyVelocity:Destroy()
               if aeroFlyConn then aeroFlyConn:Disconnect() end
               return 
            end
            
            local char = LocalPlayer.Character
            if char and char:FindFirstChild("HumanoidRootPart") and char:FindFirstChild("Humanoid") then
               local hrp = char.HumanoidRootPart
               bodyGyro.CFrame = Camera.CFrame
               bodyVelocity.velocity = Vector3.new(0, 0, 0)
               
               local moveDir = char.Humanoid.MoveDirection
               -- Pergerakan mengikuti arah kamera secara penuh (termasuk naik/turun)
               local camLook = Camera.CFrame.LookVector
               local camRight = Camera.CFrame.RightVector
               
               hrp.CFrame = hrp.CFrame + (camLook * moveDir.Z * (getgenv().AeroFlySpeed / 10)) + (camRight * moveDir.X * (getgenv().AeroFlySpeed / 10))
               -- Jika menekan tombol maju/mundur/lokasi kamera mendongak, ikut terbang naik/turun
            end
         end)
      end
   end,
})

MoveTab:CreateInput({
   Name = "⚡ Flight Velocity (No Limit)",
   PlaceholderText = "Masukkan kecepatan...",
   RemoveTextAfterFocusLost = false,
   Callback = function(Text)
      local num = tonumber(Text)
      if num then getgenv().AeroFlySpeed = num end
   end,
})

