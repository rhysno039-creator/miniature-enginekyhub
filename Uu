-- 5. Spider Climb (Fixed Raycast Detection)
getgenv().WallClimbActive = false
RunService.Stepped:Connect(function()
   if getgenv().WallClimbActive and LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart") then
      local hrp = LocalPlayer.Character.HumanoidRootPart
      -- Menggunakan Raycast modern agar benar-benar mendeteksi objek di depan
      local raycastParams = RaycastParams.new()
      raycastParams.FilterDescendantsInstances = {LocalPlayer.Character}
      raycastParams.FilterType = Enum.RaycastFilterType.Exclude
      
      local raycastResult = Workspace:Raycast(hrp.Position, hrp.CFrame.LookVector * 3, raycastParams)
      if raycastResult and raycastResult.Instance then
         hrp.Velocity = Vector3.new(hrp.Velocity.X, 60, hrp.Velocity.Z)
      end
   end
end)

