local espNameEnabled = false
local espTracerEnabled = false
local espHealthEnabled = false
local espCache = {}

local function cleanESP(player)
    if espCache[player] then
        if espCache[player].Billboard then espCache[player].Billboard:Destroy() end
        pcall(function()
            if espCache[player].Tracer then espCache[player].Tracer:Remove() end
        end)
        espCache[player] = nil
    end
end

Players.PlayerRemoving:Connect(function(player)
    cleanESP(player)
end)

Tabs.ESP:Section({ Title = "ESP & Wallhack Settings" })
Tabs.ESP:Toggle({ Title = "Player Name ESP", Default = false, Callback = function(v) espNameEnabled = v end })
Tabs.ESP:Toggle({ Title = "Tracer Line to Player", Default = false, Callback = function(v) espTracerEnabled = v end })
Tabs.ESP:Toggle({ Title = "Health Bar ESP", Default = false, Callback = function(v) espHealthEnabled = v end })

RunService.RenderStepped:Connect(function()
    local rainbowColor = Color3.fromHSV((tick() % 1), 1, 1)
    for _, player in pairs(Players:GetPlayers()) do
        if player ~= LocalPlayer and player.Character then
            local char = player.Character
            local hrp = char:FindFirstChild("HumanoidRootPart")
            local head = char:FindFirstChild("Head")
            local hum = char:FindFirstChild("Humanoid")

            if hrp and head and hum and hum.Health > 0 then
                local dist = math.floor((Workspace.CurrentCamera.CFrame.Position - hrp.Position).Magnitude)
                if not espCache[player] then
                    espCache[player] = {}
                end

                if espNameEnabled or espHealthEnabled then
                    if not espCache[player].Billboard then
                        local bg = Instance.new("BillboardGui")
                        bg.Name = "KyZenESP_UI"
                        bg.Size = UDim2.new(0, 200, 0, 50)
                        bg.StudsOffset = Vector3.new(0, 3, 0)
                        bg.AlwaysOnTop = true
                        bg.Parent = head

                        local textLabel = Instance.new("TextLabel")
                        textLabel.Name = "InfoLabel"
                        textLabel.Size = UDim2.new(1, 0, 1, 0)
                        textLabel.BackgroundTransparency = 1
                        textLabel.TextColor3 = rainbowColor
                        textLabel.TextStrokeTransparency = 0
                        textLabel.TextSize = 13
                        textLabel.Font = Enum.Font.GothamBold
                        textLabel.Parent = bg

                        espCache[player].Billboard = bg
                        espCache[player].TextLabel = textLabel
                    else
                        local textLabel = espCache[player].TextLabel
                        textLabel.TextColor3 = rainbowColor
                        local str = ""
                        if espNameEnabled then
                            str = player.Name .. " [" .. dist .. "m]"
                        end
                        if espHealthEnabled then
                            local hp = math.floor(hum.Health)
                            local maxHp = math.floor(hum.MaxHealth)
                            if str ~= "" then
                                str = str .. " | " .. hp .. "/" .. maxHp .. " HP"
                            else
                                str = hp .. "/" .. maxHp .. " HP [" .. dist .. "m]"
                            end
                        end
                        textLabel.Text = str
                        espCache[player].Billboard.Enabled = true
                    end
                else
                    if espCache[player].Billboard then
                        espCache[player].Billboard:Destroy()
                        espCache[player].Billboard = nil
                    end
                end

                if espTracerEnabled then
                    if not espCache[player].Tracer then
                        pcall(function()
                            local line = Drawing.new("Line")
                            line.Visible = false
                            line.Color = rainbowColor
                            line.Thickness = 1.5
                            line.Transparency = 1
                            espCache[player].Tracer = line
                        end)
                    end
                    if espCache[player].Tracer then
                        pcall(function()
                            espCache[player].Tracer.Color = rainbowColor
                            local vector, onScreen = Workspace.CurrentCamera:WorldToViewportPoint(hrp.Position)
                            if onScreen then
                                local screenCenter = Vector2.new(Workspace.CurrentCamera.ViewportSize.X / 2, Workspace.CurrentCamera.ViewportSize.Y)
                                espCache[player].Tracer.From = screenCenter
                                espCache[player].Tracer.To = Vector2.new(vector.X, vector.Y)
                                espCache[player].Tracer.Visible = true
                            else
                                espCache[player].Tracer.Visible = false
                            end
                        end)
                    end
                else
                    if espCache[player].Tracer then
                        pcall(function() espCache[player].Tracer:Remove() end)
                        espCache[player].Tracer = nil
                    end
                end

            else
                cleanESP(player)
            end
        else
            cleanESP(player)
        end
    end
end)

