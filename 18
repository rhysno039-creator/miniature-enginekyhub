-- ==================== VARIABEL & LOGIC AUTO FARM ====================
local Players = game:GetService("Players")
local Workspace = game:GetService("Workspace")
local RunService = game:GetService("RunService")
local LocalPlayer = Players.LocalPlayer

local autoTreadmillEnabled = false
local auto2xTrainEnabled = false
local instantInteractEnabled = false

-- Fungsi helper untuk mencari plot pemain
local function getMyPlot()
   local plotsFolder = Workspace:FindFirstChild("Plots") or Workspace:FindFirstChild("Plot")
   if not plotsFolder then
      for _, v in ipairs(Workspace:GetChildren()) do
         if v:IsA("Folder") and (v.Name:lower():find("plot") or v.Name:lower():find("base")) then
            plotsFolder = v
            break
         end
      end
   end
   
   if plotsFolder then
      for _, plot in ipairs(plotsFolder:GetChildren()) do
         local owner = plot:FindFirstChild("Owner") or plot:FindFirstChild("Sign") or plot:FindFirstChild("Data")
         if owner then
            if (owner:IsA("ObjectValue") and owner.Value == LocalPlayer) or 
               (owner:IsA("StringValue") and owner.Value == LocalPlayer.Name) or
               (plot.Name:lower():find(LocalPlayer.Name:lower())) then
               return plot
            end
         end
      end
   end
   return nil
end

local function getBaseCFrame()
   local plot = getMyPlot()
   if plot then
      local basePart = plot:FindFirstChild("Base") or plot:FindFirstChild("Floor") or plot:FindFirstChild("SpawnLocation")
      if basePart and basePart:IsA("BasePart") then
         return basePart.CFrame + Vector3.new(0, 5, 0)
      end
   end
   if LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart") then
      return LocalPlayer.Character.HumanoidRootPart.CFrame
   end
   return CFrame.new(0, 10, 0)
end

local function getTreadmillCFrame()
   local plot = getMyPlot()
   if plot then
      local treadmill = plot:FindFirstChild("Treadmill", true) or plot:FindFirstChild("Machine", true)
      if treadmill then
         if treadmill:IsA("Model") and treadmill.PrimaryPart then
            return treadmill.PrimaryPart.CFrame + Vector3.new(0, 3, 0)
         elseif treadmill:IsA("BasePart") then
            return treadmill.CFrame + Vector3.new(0, 3, 0)
         end
      end
   end
   return getBaseCFrame()
end

-- Auto Treadmill Loop
task.spawn(function()
   while true do
      if autoTreadmillEnabled then
         pcall(function()
            local plot = getMyPlot()
            if plot then
               local remote = plot:FindFirstChild("TreadmillRemote", true) or plot:FindFirstChild("TrainRemote", true) or Workspace:FindFirstChild("TreadmillRemote", true)
               if remote and remote:IsA("RemoteEvent") then
                  remote:FireServer()
               end
            end
         end)
      end
      task.wait(0.5)
   end
end)

-- Auto 2X Train / Boost Loop
task.spawn(function()
   while true do
      if auto2xTrainEnabled then
         pcall(function()
            local plot = getMyPlot()
            if plot then
               local remote2x = plot:FindFirstChild("2XTrainRemote", true) or plot:FindFirstChild("BoostRemote", true)
               if remote2x and remote2x:IsA("RemoteEvent") then
                  remote2x:FireServer()
               end
            end
         end)
      end
      task.wait(1)
   end
end)

-- Instant Interact Loop (ProximityPrompt)
task.spawn(function()
   while true do
      if instantInteractEnabled then
         pcall(function()
            for _, v in ipairs(Workspace:GetDescendants()) do
               if v:IsA("ProximityPrompt") then
                  v.HoldDuration = 0
               end
            end
         end)
      end
      task.wait(1)
   end
end)


