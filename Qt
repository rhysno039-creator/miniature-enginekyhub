local antiFallConn = nil
PlayerTab:Toggle({
    Title = "Anti Fall Damage Toggle",
    Default = false,
    Callback = function(v)
        if v then
            pcall(function()
                if Humanoid then
                    local lastH = Humanoid.Health
                    antiFallConn = Humanoid.HealthChanged:Connect(function(newH)
                        if newH < lastH then
                            local state = Humanoid:GetState()
                            if state == Enum.HumanoidStateType.Freefall or state == Enum.HumanoidStateType.FallingDown then
                                Humanoid.Health = lastH
                            else
                                lastH = newH
                            end
                        else
                            lastH = newH
                        end
                    end)
                end
            end)
        else
            if antiFallConn then antiFallConn:Disconnect() antiFallConn = nil end
        end
    end
})

