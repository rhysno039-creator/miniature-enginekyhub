local StatsParagraph = HomeTab:Paragraph({
    Title = "Live Counter",
    Desc = "FPS: Calculating...\nPing: Calculating...\nServer Time: Calculating..."
})

task.spawn(function()
    local lastTick = tick()
    local frameCount = 0
    local fps = 0
    RunService.RenderStepped:Connect(function()
        frameCount = frameCount + 1
        if tick() - lastTick >= 1 then
            fps = frameCount
            frameCount = 0
            lastTick = tick()
        end
    end)

    while task.wait(1) do
        local pingVal = 0
        pcall(function()
            if LocalPlayer.GetNetworkPing then
                pingVal = math.floor(LocalPlayer:GetNetworkPing() * 1000)
            end
        end)
        pcall(function()
            StatsParagraph:SetDesc(string.format("FPS: %d\nPing: %d ms\nServer Time: %s", fps, pingVal, os.date("%I:%M:%S %p")))
        end)
    end
end)

