EspTab:Section({ Title = "ESP & Wallhack Features (Rainbow)" })

local espActive = false
local espTeamCheck = true
local highlights = {}

local function updateEsp()
    for _, p in ipairs(Players:GetPlayers()) do
        if p ~= LocalPlayer then
            if espActive then
                if p.Character and not p.Character:FindFirstChild("KyZenHighlight") then
                    if not espTeamCheck or p.Team ~= LocalPlayer.Team then
                        local hl = Instance.new("Highlight")
                        hl.Name = "KyZenHighlight"
                        hl.Adornee = p.Character
                        hl.FillTransparency = 0.5
                        hl.OutlineTransparency = 0
                        hl.Parent = p.Character
                        highlights[p] = hl
                    end
                end
            else
                if p.Character and p.Character:FindFirstChild("KyZenHighlight") then
                    p.Character.KyZenHighlight:Destroy()
                    highlights[p] = nil
                end
            end
        end
    end
end

